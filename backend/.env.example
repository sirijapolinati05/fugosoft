# FugoSoft Backend Environment Variables
# Copy this file to .env and replace with your actual database and server credentials.

# PostgreSQL connection string:
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fugosoft

# Server Configuration
HOST=127.0.0.1
PORT=8000
